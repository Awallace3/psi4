# Configuration/loader policy ONLY; no scientific or GPU algorithm patches.
# The exact064 upstream package install rules are retained, unlike the d17 hook.
include_guard(GLOBAL)
foreach(_name DISP0_SDK_CONTRACT DISP0_DEPENDENCY_PREFIX)
  if(NOT DEFINED ${_name} OR "${${_name}}" STREQUAL "")
    message(FATAL_ERROR "Missing optimized build input: ${_name}")
  endif()
endforeach()
if(NOT PROJECT_NAME STREQUAL "Einsums" OR NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  message(FATAL_ERROR "This hook belongs only to top-level project(Einsums)")
endif()
if(CMAKE_SKIP_RPATH OR CMAKE_SKIP_INSTALL_RPATH OR NOT CMAKE_INSTALL_LIBDIR STREQUAL "lib")
  message(FATAL_ERROR "Optimized installed loader/layout policy disabled")
endif()
file(READ "${DISP0_SDK_CONTRACT}" _sdk)
string(JSON _cuda GET "${_sdk}" private_prefix)
set(CUDAToolkit_ROOT "${_cuda}" CACHE PATH "" FORCE)
foreach(_family cudart cublas cublasLt cusolver cusparse nvJitLink)
  set(CUDA_${_family}_LIBRARY "${_cuda}/lib64/lib${_family}.so" CACHE FILEPATH "" FORCE)
endforeach()
set(EINSUMS_WITH_FULL_RPATH OFF CACHE BOOL "" FORCE)
set(CMAKE_INSTALL_RPATH_USE_LINK_PATH FALSE)
set(CMAKE_INSTALL_RPATH "\$ORIGIN;${_cuda}/lib64;${DISP0_DEPENDENCY_PREFIX}/lib")
set(CMAKE_BUILD_RPATH_USE_ORIGIN TRUE)

function(disp0_opt_targets directory output)
  get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(_child IN LISTS _children)
    disp0_opt_targets("${_child}" _more)
    list(APPEND _targets ${_more})
  endforeach()
  set(${output} "${_targets}" PARENT_SCOPE)
endfunction()

function(disp0_opt_finalize)
  file(READ "${DISP0_SDK_CONTRACT}" _sdk)
  string(JSON _cuda GET "${_sdk}" private_prefix)
  string(JSON _includes GET "${_sdk}" include)
  string(JSON _library_root GET "${_sdk}" library_root)
  get_property(_imports DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY IMPORTED_TARGETS)
  set(_bound "")
  set(_report "")
  set(_include_report "")
  foreach(_target IN LISTS _imports)
    if(NOT _target MATCHES "^CUDA::")
      continue()
    endif()
    get_target_property(_configs "${_target}" IMPORTED_CONFIGURATIONS)
    set(_properties IMPORTED_LOCATION)
    foreach(_config IN LISTS _configs)
      string(TOUPPER "${_config}" _upper)
      list(APPEND _properties "IMPORTED_LOCATION_${_upper}")
    endforeach()
    foreach(_property IN LISTS _properties)
      get_target_property(_location "${_target}" "${_property}")
      if(NOT _location OR _location MATCHES "-NOTFOUND$")
        continue()
      endif()
      file(REAL_PATH "${_location}" _real)
      string(JSON _expected ERROR_VARIABLE _error GET "${_sdk}" allowed_files "${_real}")
      if(NOT _error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Unattested imported CUDA target: ${_target}: ${_real}")
      endif()
      file(SHA256 "${_real}" _sha)
      if(NOT _sha STREQUAL _expected)
        message(FATAL_ERROR "Changed CUDA target bytes: ${_target}")
      endif()
      # FindCUDAToolkit may derive a genuine original locator from nvcc's TOP.
      # Rebind ONLY after full file/hash inventory admission, before generating
      # any actual compilation. Unknown/site12 files never pass this check.
      file(RELATIVE_PATH _relative "${_library_root}" "${_real}")
      if(_relative MATCHES "^\\.\\.")
        message(FATAL_ERROR "CUDA target outside complete input library tree: ${_target}")
      endif()
      set(_locator "${_cuda}/lib64/${_relative}")
      file(REAL_PATH "${_locator}" _locator_real)
      if(NOT EXISTS "${_locator}" OR NOT _locator_real STREQUAL _real)
        message(FATAL_ERROR "Missing private CUDA locator: ${_target}")
      endif()
      set_property(TARGET "${_target}" PROPERTY "${_property}" "${_locator}")
      list(APPEND _bound "${_target}")
      string(APPEND _report "${_target}\t${_property}\t${_locator}\t${_real}\t${_sha}\n")
    endforeach()
    get_target_property(_dirs "${_target}" INTERFACE_INCLUDE_DIRECTORIES)
    if(_dirs AND NOT _dirs MATCHES "-NOTFOUND$")
      foreach(_dir IN LISTS _dirs)
        if(_dir MATCHES "\\$<")
          message(FATAL_ERROR "Uninspectable CUDA include expression: ${_target}")
        endif()
        string(APPEND _include_report "${_target}\t${_dir}\n")
      endforeach()
      # The complete copied include tree is hash-bound in the SDK manifest.
      # Never inherit nvcc's original or site include directory as a target
      # usage requirement; actual compiler dependencies are audited afterward.
      set_property(TARGET "${_target}" PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_cuda}/include")
    endif()
  endforeach()
  foreach(_family cudart cublas cublasLt cusolver cusparse nvJitLink)
    if(NOT "CUDA::${_family}" IN_LIST _bound)
      message(FATAL_ERROR "Missing mandatory attested CUDA target: ${_family}")
    endif()
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/disp0-cuda-targets.tsv" "${_report}")
  file(WRITE "${CMAKE_BINARY_DIR}/disp0-original-cuda-includes.tsv" "${_include_report}")
  foreach(_required Einsums PyEinsums PyEinsumsStubs waggle waggle_core)
    if(NOT TARGET "${_required}")
      message(FATAL_ERROR "Missing required optimized E2 target: ${_required}")
    endif()
  endforeach()
  get_target_property(_native_type Einsums TYPE)
  if(NOT _native_type STREQUAL "SHARED_LIBRARY")
    message(FATAL_ERROR "One shared native Einsums world is required")
  endif()
  disp0_opt_targets("${CMAKE_SOURCE_DIR}" _targets)
  set(_report "")
  foreach(_target IN LISTS _targets)
    get_target_property(_type "${_target}" TYPE)
    if(NOT (_type STREQUAL "SHARED_LIBRARY" OR _type STREQUAL "MODULE_LIBRARY"))
      continue()
    endif()
    set(_origin "\$ORIGIN")
    if(_target STREQUAL "PyEinsums" OR _target STREQUAL "waggle_core")
      set(_origin "\$ORIGIN/..")
    endif()
    set(_rpath "${_origin};${_cuda}/lib64;${DISP0_DEPENDENCY_PREFIX}/lib")
    set_target_properties("${_target}" PROPERTIES
      INSTALL_RPATH "${_rpath}" INSTALL_RPATH_USE_LINK_PATH FALSE
      BUILD_WITH_INSTALL_RPATH FALSE SKIP_BUILD_RPATH FALSE)
    target_link_options("${_target}" PRIVATE "LINKER:--enable-new-dtags")
    # Preserve native whole-package install rules. Only auxiliary native shared
    # libraries lacking their own install rule may be added by future review.
    string(APPEND _report "${_target}\t${_rpath}\n")
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/disp0-install-targets.tsv" "${_report}")
endfunction()
cmake_language(DEFER CALL disp0_opt_finalize)
