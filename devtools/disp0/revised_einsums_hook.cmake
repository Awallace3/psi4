# Configuration/installation only. Exact upstream E2d17 source stays untouched.
# Inject with CMAKE_PROJECT_Einsums_INCLUDE, NOT an early find_package(CUDA):
# E2's setup skips enable_language/config defines if CUDA::cudart already exists.
include_guard(GLOBAL)
foreach(_name DISP0_SDK_CONTRACT DISP0_SDK_CONTRACT_SHA256 DISP0_DEPENDENCY_PREFIX)
  if(NOT DEFINED ${_name} OR "${${_name}}" STREQUAL "")
    message(FATAL_ERROR "Required revised contract input missing: ${_name}")
  endif()
endforeach()
if(NOT PROJECT_NAME STREQUAL "Einsums" OR NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  message(FATAL_ERROR "Revised E2 hook belongs only to project(Einsums)")
endif()
if(CMAKE_SKIP_RPATH OR CMAKE_SKIP_INSTALL_RPATH)
  message(FATAL_ERROR "Installed loader paths must not be disabled")
endif()
if(NOT CMAKE_INSTALL_LIBDIR STREQUAL "lib")
  message(FATAL_ERROR "Revised E2 contract requires prefix/lib layout")
endif()
file(SHA256 "${DISP0_SDK_CONTRACT}" _actual_contract_sha)
if(NOT _actual_contract_sha STREQUAL DISP0_SDK_CONTRACT_SHA256)
  message(FATAL_ERROR "Private CUDA contract changed")
endif()
file(READ "${DISP0_SDK_CONTRACT}" _disp0_sdk)
string(JSON DISP0_PRIVATE_CUDA GET "${_disp0_sdk}" private_prefix)
foreach(_family cudart cublas cublasLt cusolver cusparse nvJitLink)
  set(CUDA_${_family}_LIBRARY "${DISP0_PRIVATE_CUDA}/lib64/lib${_family}.so" CACHE FILEPATH "" FORCE)
endforeach()
set(CUDAToolkit_ROOT "${DISP0_PRIVATE_CUDA}" CACHE PATH "" FORCE)
set(CMAKE_CUDA_COMPILER "${DISP0_PRIVATE_CUDA}/bin/nvcc" CACHE FILEPATH "" FORCE)
set(CMAKE_BUILD_RPATH_USE_ORIGIN TRUE)
set(EINSUMS_WITH_FULL_RPATH OFF CACHE BOOL "" FORCE)
set(CMAKE_INSTALL_RPATH_USE_LINK_PATH FALSE)
set(CMAKE_INSTALL_RPATH "\$ORIGIN;${DISP0_PRIVATE_CUDA}/lib64;${DISP0_DEPENDENCY_PREFIX}/lib")
# Dependency discovery uses explicit prefixes. Never inherit a site CUDA SDK.
set(CMAKE_FIND_USE_SYSTEM_ENVIRONMENT_PATH FALSE)
set(CMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH FALSE)
set(CMAKE_FIND_USE_CMAKE_SYSTEM_PATH FALSE)
set(CMAKE_PROGRAM_PATH "${DISP0_DEPENDENCY_PREFIX}/bin;/usr/bin;/bin")

function(disp0_all_build_targets directory output)
  get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(_child IN LISTS _children)
    disp0_all_build_targets("${_child}" _child_targets)
    list(APPEND _targets ${_child_targets})
  endforeach()
  set(${output} "${_targets}" PARENT_SCOPE)
endfunction()

function(disp0_finalize_install)
  file(READ "${DISP0_SDK_CONTRACT}" _sdk)
  string(JSON _private GET "${_sdk}" private_prefix)
  string(JSON _library_root GET "${_sdk}" library_root)
  string(JSON _include_root GET "${_sdk}" include)
  foreach(_required cudart cublas cublasLt cusolver cusparse nvJitLink)
    if(NOT TARGET CUDA::${_required})
      message(FATAL_ERROR "Missing required CUDA target: ${_required}")
    endif()
  endforeach()
  get_property(_imports DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY IMPORTED_TARGETS)
  set(_target_report "")
  set(_bound_targets "")
  foreach(_target IN LISTS _imports)
    if(NOT _target MATCHES "^CUDA::")
      continue()
    endif()
    get_target_property(_configs "${_target}" IMPORTED_CONFIGURATIONS)
    set(_properties IMPORTED_LOCATION)
    foreach(_config IN LISTS _configs)
      string(TOUPPER "${_config}" _upper)
      list(APPEND _properties "IMPORTED_LOCATION_${_upper}")
    endforeach()
    foreach(_property IN LISTS _properties)
      get_target_property(_location "${_target}" "${_property}")
      if(NOT _location OR _location MATCHES "-NOTFOUND$")
        continue()
      endif()
      file(REAL_PATH "${_location}" _real)
      string(JSON _expected ERROR_VARIABLE _error GET "${_sdk}" allowed_files "${_real}")
      if(NOT _error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "CUDA target escaped attested SDK: ${_target}: ${_real}")
      endif()
      file(SHA256 "${_real}" _observed)
      if(NOT _observed STREQUAL _expected)
        message(FATAL_ERROR "CUDA target identity changed: ${_target}")
      endif()
      file(RELATIVE_PATH _relative "${_library_root}" "${_real}")
      if(_relative MATCHES "^\\.\\.")
        message(FATAL_ERROR "CUDA target is outside the attested library tree")
      endif()
      set(_locator "${_private}/lib64/${_relative}")
      file(REAL_PATH "${_locator}" _locator_real)
      if(NOT EXISTS "${_locator}" OR NOT _locator_real STREQUAL _real)
        message(FATAL_ERROR "Missing private CUDA developer locator: ${_locator}")
      endif()
      set_property(TARGET "${_target}" PROPERTY "${_property}" "${_locator}")
      list(APPEND _bound_targets "${_target}")
      string(APPEND _target_report "${_target}\t${_property}\t${_locator}\t${_real}\t${_observed}\n")
    endforeach()
    get_target_property(_includes "${_target}" INTERFACE_INCLUDE_DIRECTORIES)
    if(_includes AND NOT _includes MATCHES "-NOTFOUND$")
      set(_private_includes "")
      foreach(_include IN LISTS _includes)
        if(_include MATCHES "\\$<")
          message(FATAL_ERROR "Uninspectable CUDA include expression: ${_target}")
        endif()
        file(REAL_PATH "${_include}" _real_include)
        file(RELATIVE_PATH _relative "${_include_root}" "${_real_include}")
        if(_relative MATCHES "^\\.\\.")
          message(FATAL_ERROR "CUDA header target escaped attested headers: ${_target}")
        endif()
        list(APPEND _private_includes "${_private}/include/${_relative}")
      endforeach()
      set_property(TARGET "${_target}" PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_private_includes}")
    endif()
    get_target_property(_links "${_target}" INTERFACE_LINK_LIBRARIES)
    string(REGEX MATCHALL "CUDA::[A-Za-z0-9_]+" _cuda_links "${_links}")
    foreach(_link IN LISTS _cuda_links)
      if(NOT TARGET "${_link}")
        message(FATAL_ERROR "Missing transitive CUDA target: ${_link}")
      endif()
    endforeach()
  endforeach()
  foreach(_required cudart cublas cublasLt cusolver cusparse nvJitLink)
    if(NOT "CUDA::${_required}" IN_LIST _bound_targets)
      message(FATAL_ERROR "Required CUDA target has no attested library: ${_required}")
    endif()
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/disp0-cuda-targets.tsv" "${_target_report}")
  foreach(_target Einsums PyEinsums PyEinsumsStubs)
    if(NOT TARGET "${_target}")
      message(FATAL_ERROR "Missing exact E2d17 target: ${_target}")
    endif()
  endforeach()
  get_target_property(_native_type Einsums TYPE)
  if(NOT _native_type STREQUAL "SHARED_LIBRARY")
    message(FATAL_ERROR "E2 native target must be one shared library")
  endif()
  disp0_all_build_targets("${CMAKE_SOURCE_DIR}" _targets)
  set(_installed "")
  foreach(_target IN LISTS _targets)
    get_target_property(_type "${_target}" TYPE)
    if(_type STREQUAL "SHARED_LIBRARY" OR _type STREQUAL "MODULE_LIBRARY")
      set(_origin "\$ORIGIN")
      if(_target STREQUAL "PyEinsums")
        set(_origin "\$ORIGIN/..")
      endif()
      set_target_properties("${_target}" PROPERTIES
        INSTALL_RPATH "${_origin};${_private}/lib64;${DISP0_DEPENDENCY_PREFIX}/lib"
        INSTALL_RPATH_USE_LINK_PATH FALSE BUILD_WITH_INSTALL_RPATH FALSE
        SKIP_BUILD_RPATH FALSE BUILD_RPATH_USE_ORIGIN TRUE)
      target_link_options("${_target}" PRIVATE "LINKER:--enable-new-dtags")
      if(_target STREQUAL "PyEinsums")
        install(TARGETS "${_target}" LIBRARY DESTINATION lib/einsums)
      elseif(NOT _target STREQUAL "Einsums")
        # E2 already installs its native library. Include built shared
        # dependencies (e.g. fetched cpptrace), never an old build-tree RPATH.
        install(TARGETS "${_target}" LIBRARY DESTINATION lib)
      endif()
      string(APPEND _installed "${_target}\t${_origin};${_private}/lib64;${DISP0_DEPENDENCY_PREFIX}/lib\n")
    endif()
  endforeach()
  # Generated rc.py, stubs, subpackages and helpers are part of the package.
  # The extension itself must use install(TARGETS), not a raw RPATH-preserving copy.
  install(DIRECTORY "${CMAKE_BINARY_DIR}/lib/einsums/" DESTINATION lib/einsums
    PATTERN "_core*.so" EXCLUDE PATTERN "__pycache__" EXCLUDE)
  file(WRITE "${CMAKE_BINARY_DIR}/disp0-install-targets.tsv" "${_installed}")
endfunction()

cmake_language(DEFER CALL disp0_finalize_install)
