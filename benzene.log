#!/bin/bash
cat ./build.sh

start_time=$(date +%s)
branch_name=$(git branch | grep \* | cut -d ' ' -f2)
objdir_name="build_$branch_name"
echo "building $objdir_name"
export CXXFLAGS="-flto=auto"
export CXXFLAGS=""

ein_saptdft_builds=("build_saptdft_ein" "build_saptdft_ein_fi" "build_saptdft_ein_
fi_option" "build_saptdft_ein_fi_option_C" "build_saptdft_ein_fi_option_d4" "build
_ccsd_einsums" "build_dfhelper_ofcore" "build_disp_jkobj")

# if not build directory exists, create it and run cmake
if [ ! -d "$objdir_name" ]; then
    echo "creating $objdir_name"
    # if [[ " ${ein_saptdft_builds[@]} " =~ " $objdir_name " ]]; then
        # cmake  -DBUILD_SHARED_LIBS=ON \
        #     -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        #     -DENABLE_Einsums=ON \
        #     -DENABLE_HDF5=ON \
        #     -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -S. -B $objdir_name -G Ninja \
        #     -DEinsums_DIR=/home/awallace43/gits/einsums/install/share/cmake/Eins
ums
    # else
        cmake  -DBUILD_SHARED_LIBS=ON -DENABLE_Einsums=ON -DCMAKE_EXPORT_COMPILE_C
OMMANDS=ON -S. -B $objdir_name -G Ninja
        # cmake  -DCMAKE_INSIST_FIND_PACKAGE_qcengine=ON -DBUILD_SHARED_LIBS=ON -D
ENABLE_Einsums=ON -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -S. -B $objdir_name -G Ninja
    # fi
fi
#
        # cmake  -DBUILD_SHARED_LIBS=ON -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -S. -B 
$objdir_name -G Ninja
# cmake  -DBUILD_SHARED_LIBS=ON \
#     -DEinsums_DIR=/home/awallace43/gits/einsums/install/share/cmake/Einsums \
#     -DCMAKE_BUILD_TYPE=Debug \
#     -DENABLE_Einsums=ON \
#     -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -S. -B $objdir_name -G Ninja

# cmake  -DBUILD_SHARED_LIBS=ON -DENABLE_Einsums=ON -DCMAKE_EXPORT_COMPILE_COMMAND
S=ON -S. -B $objdir_name -G Ninja
cmake --build $objdir_name -j 16
# check if psi4/compile_commands.json does not exist
if [ -f compile_commands.json ]; then
    rm compile_commands.json
fi
ln -s $objdir_name/psi4-core-prefix/src/psi4-core-build/compile_commands.json comp
ile_commands.json

cd $objdir_name
stubgen -m psi4.core -o ./stage/lib/
cd ..

$objdir_name/stage/bin/psi4 --psiapi
eval `$objdir_name/stage/bin/psi4 --psiapi`
end_time=$(date +%s)
echo "Elapsed time: $((end_time - start_time)) seconds"
echo ""
if [ -f timer.dat ]; then
    rm timer.dat
fi

# List of build names that run test_saptdft.py
saptdft_builds=("build_saptdft_auto_grac" "build_delta_dft" "build_delta_dft_rb1" 
"build_ext_pot_saptdft" "build_saptdft_ext_pot" "build_extpot_deltadft" "build_sap
tdft_ext_pot_d4")

if [ "build_fsapt_qca" == "$objdir_name" ]; then
    # python3 ./tests/pytests/test_saptdft.py
    # cd $objdir_name
    # ctest -R fsapt-d4
    # cd ..
    python3 ./tests/pytests/test_fisapt.py
    # python3 ./tests/pytests/test_saptdft.py
    # pytest ./tests/pytests/test_qcfractal.py
    # psi4 -n 8 ./tests/sapt-dft1/input.dat
fi

if [[ " ${ein_saptdft_builds[@]} " =~ " $objdir_name " ]]; then
    export PYTHONPATH=$PYTHONPATH:/home/awallace43/gits/einsums_qca/install/lib
    # psi4 -n 8 ./tests/sapt-dft1/input.dat
    # python tests/pytests/test_saptdft.py
    python tests/pytests/test_fsaptdft.py
    # pytest -k test_qcng_embedded_saptdft tests/pytests/test_saptdft.py
    # python tests/pytests/test_addons.py
    # python tests/pytests/test_fsaptdft.py
    # python3 tests/pytests/test_fisapt.py
fi

if [[ "build_xdm_sapt_only" == "$objdir_name" ]]; then
    # python3 ./tests/pytests/test_xdm.py
    python3 ./tests/pytests/test_saptdft.py
fi

rm psi\.*
rm pytest_output*
