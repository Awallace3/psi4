#! MBIS regression test catching ECPs

molecule mol {
  0 1
  C 0.000000 0.000000 0.000000
  I 0.000000 0.000000 2.105000
  H 0.000000 0.937000 -0.297000
  H 0.811000 -0.469000 -0.297000
  H -0.811000 -0.469000 -0.297000
  symmetry c1
  no_reorient
  no_com
}

set {
  scf_type df
  d_convergence 8
  e_convergence 10
  mbis_radial_points 99
  mbis_spherical_points 350
  max_radial_moment 4
}

if psi4.core.get_option("scf", "orbital_optimizer_package") != "INTERNAL":  # KP-CONV
    psi4.set_options({"d_convergence": 3e-8})

# A real ECP wavefunction; native MBIS must reject it before any shell update.
e, wfn = energy("scf/def2-svp", molecule=mol, return_wfn=True)
compare(True, wfn.basisset().has_ECP(), "Wavefunction carries an ECP")

rejected = False
try:
    oeprop(wfn, "MBIS_CHARGES")
except RuntimeError as err:
    if "MBIS incompatible with ECP" not in str(err):
        raise
    rejected = True
compare(True, rejected, "MBIS correctly rejects ECP systems")
compare_values(0.0, wfn.variable("MBIS CONVERGED"), 12, "Rejected attempt is not converged")
compare_values(0.0, wfn.variable("MBIS ITERATIONS"), 12, "Rejected before any shell update")
for name in ("MBIS SHELL COUNTS", "MBIS SHELL POPULATIONS", "MBIS SHELL WIDTHS"):
    compare(False, wfn.has_array_variable(name), f"No {name} after rejection")
